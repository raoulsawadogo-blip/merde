exemple de programme : Inversion de nombres avec les pointeurs

#include <stdio.h>

void inversion (int *pointA, int *pointB) /*(ici l'utilisation des pointeurs comme parametre signifie que nous allons travailler avec les adresses 
des variables que nous allons definir , les variables qui seront mi comme parametre lorsque nous ferons appel a notre fonction inversion ')*/
{
    int constante;
    constante=*pointA; //indique au programme de modifier la valeur reel de point A car cette fonction travaille directement avec les adresses et non avec des copies comme les fonctions simples
    *pointA=*pointB;//Meme chose 
    *pointB=constante;//Meme chose merde 
    printf("Apres inversion : %d et %d", *pointA,*pointB);//Bof ici le printf c'est juste pour ne pas le faire dans le main sinon on pourrait bel et bien l'ecrire apres l'appel de la fonction

}

int main(void)
{
    int nom1=56;
    int nom2=67;
    printf("Avant inversion : %d et %d \n" , nom1,nom2);
    inversion(&nom1,&nom2);//ne jamais oublier '&' lors de l'appel avec une fontion pointee (C'est un nom inventee mais bon tu aura compris)
    return 0;
}

